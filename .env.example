# DocuSign OAuth configuration
# Copy this file to .env.local for local development. Never commit real values.
DOCUSIGN_CLIENT_ID=your_docusign_integration_key
DOCUSIGN_CLIENT_SECRET=your_docusign_client_secret
DOCUSIGN_TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_secret
DOCUSIGN_REDIRECT_URI=http://localhost:4173/api/docusign/callback
DOCUSIGN_ENVIRONMENT=demo

# Optional standalone Python adapter (not used by the hosted app)
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_ACCESS_TOKEN=
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
